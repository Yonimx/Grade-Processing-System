<%
	String navUri = request.getRequestURI();
	boolean navResults = navUri.endsWith("results.jsp");
	boolean navSample = navUri.endsWith("sample.jsp");
	boolean navHome = !navResults && !navSample;
%>
<header class="topbar">
	<div class="container topbar-inner">
		<a class="brand" href="<%= request.getContextPath() %>/index.jsp">
			<span class="brand-mark">GF</span>
			<span class="brand-text">GradeFlow<small>Academic Grade Processing System</small></span>
		</a>
		<nav class="nav-links">
			<a href="<%= request.getContextPath() %>/index.jsp" class="<%= navHome ? "active" : "" %>">Process Grades</a>
			<a href="<%= request.getContextPath() %>/results.jsp" class="<%= navResults ? "active" : "" %>">Results</a>
			<a href="<%= request.getContextPath() %>/sample.jsp" class="<%= navSample ? "active" : "" %>">Sample CSV</a>
		</nav>
	</div>
</header>
